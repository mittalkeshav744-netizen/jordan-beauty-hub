# Copy this file to backend/.env and replace the placeholder values.
# Never commit backend/.env.

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

# SQLite database file, relative to the backend folder.
SQLITE_PATH=db.sqlite3

# Comma-separated list of frontend origins allowed to call the API with cookies.
# Include :5173 for the Vite dev server and :8000 when Django serves the built shop.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Store settings (amounts in INR). 0 disables the fee / threshold.
SHIPPING_FLAT_FEE=0.00
FREE_SHIPPING_THRESHOLD=0.00
MAX_CART_ITEM_QUANTITY=10

# Business WhatsApp number with country code, digits only (e.g. 91XXXXXXXXXX).
# Leave empty to hide the "Chat on WhatsApp" links.
STORE_WHATSAPP_NUMBER=

# Address customers use to open the shop; reset-password emails link here.
# Use http://127.0.0.1:8000 when you open the shop from Django after `npm run build`.
FRONTEND_URL=http://localhost:5173

# Optional. Folder with the React build (default: ../frontend/dist relative to backend/).
# FRONTEND_DIST=

# Email. The console backend prints emails in the Django terminal (development).
# For real delivery use django.core.mail.backends.smtp.EmailBackend and fill in
# your mail provider's details in backend/.env (never in this file).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=webmaster@localhost

# Production only (used when DJANGO_DEBUG=False)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
