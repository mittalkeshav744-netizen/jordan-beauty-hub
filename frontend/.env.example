# Copy to frontend/.env.local if you need to change these. Every VITE_ variable
# is bundled into the public JavaScript — never put secrets here.

# Base URL of the Django API as seen by the browser. Keep "/api" when the
# frontend and backend are served from the same domain (and in development,
# where Vite proxies /api to Django).
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api and /media requests (development only).
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000
